{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/worker/Dockerfile",
    "watchPatterns": [
      "apps/web/**",
      "packages/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".npmrc",
      "tsconfig.base.json",
      ".dockerignore",
      "docker/worker/**",
      "railway/worker.json",
      ".railway/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "sleepApplication": false,
    "overlapSeconds": 0,
    "drainingSeconds": 60,
    "limitOverride": {
      "containers": {
        "cpu": 1,
        "memoryBytes": 268435456
      }
    }
  }
}
