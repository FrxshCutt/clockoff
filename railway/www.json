{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/www-redirect/Dockerfile",
    "watchPatterns": ["docker/www-redirect/**", "railway/www.json", ".railway/**"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "sleepApplication": false,
    "overlapSeconds": 5,
    "drainingSeconds": 5,
    "limitOverride": {
      "containers": {
        "cpu": 0.5,
        "memoryBytes": 134217728
      }
    }
  }
}
