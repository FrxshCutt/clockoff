{
  "name": "@workmode/web",
  "version": "0.1.0",
  "private": true,
  "description": "Manager dashboard, marketing pages and all API route handlers (manager + mobile).",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "build": "dotenv -e ../../.env -c -- next build",
    "start": "dotenv -e ../../.env -- next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "dotenv -e ../../.env -c -- vitest run --project unit",
    "test:integration": "dotenv -e ../../.env -c -- vitest run --project integration",
    "test:all": "dotenv -e ../../.env -c -- vitest run",
    "test:e2e": "dotenv -e ../../.env -c -- playwright test",
    "jobs": "dotenv -e ../../.env -- tsx src/jobs/main.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-table": "8.21.3",
    "@workmode/db": "workspace:*",
    "@workmode/shared": "workspace:*",
    "@workmode/validation": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "jose": "6.2.12",
    "lucide-react": "1.52.0",
    "luxon": "3.7.2",
    "nanoid": "6.0.1",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "node-cron": "4.6.0",
    "papaparse": "5.7.0",
    "pino": "10.4.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "rrule": "2.8.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.1",
    "@types/node-cron": "3.0.11",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@workmode/config": "workspace:*",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
