# ──────────────────────────────────────────────────────────────────────────────
# ClockOff web app — PRODUCTION environment (Netlify site, package directory apps/web).
# Every variable the deployed app reads. Set them on the Netlify site (scope: Builds + Functions + Edge
# Functions) with `netlify env:set <NAME> <value> --context production` or the Netlify API.
# Never commit real values. Generate secrets with the commands at the bottom.
# Full reference: docs/ENVIRONMENT.md · deployment runbook: docs/DEPLOYMENT.md
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Neon, EU region) ───────────────────────────────────────────────
# Pooled connection used by the app at runtime (Neon "-pooler" host). Keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-2.aws.neon.tech/clockoff?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (unpooled) connection — used ONLY to run migrations (`DATABASE_URL="$DIRECT_URL" prisma migrate deploy`).
# Not read by the running app; keep it out of Netlify (migrations run from a trusted machine or CI).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/clockoff?sslmode=require"

# ── Hostnames ────────────────────────────────────────────────────────────────
# Dashboard + all APIs (manager and mobile). Used for email links, CSRF origin checks and cookies.
APP_URL="https://app.clockoff.online"
NEXT_PUBLIC_APP_URL="https://app.clockoff.online"
# Marketing site (apex). www.<apex> redirects here.
MARKETING_URL="https://clockoff.online"
# "on" makes one deployment serve both sites by hostname (src/server/http/hostRouting.ts).
# Requests to other hosts (e.g. *.netlify.app deploy previews) are never rerouted.
HOST_ROUTING="on"
# Optional: extra hostnames that should redirect to MARKETING_URL (comma-separated).
MARKETING_ALIAS_HOSTS=""
# Shown in employee invite instructions until the iOS app is on the App Store.
NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/clockoff/id0000000000"

# ── Manager auth ─────────────────────────────────────────────────────────────
# (The Auth.js equivalents AUTH_SECRET/AUTH_URL are SESSION_SECRET/APP_URL here — first-party sessions, D-007.)
SESSION_SECRET=""                     # 32+ random bytes
SESSION_TTL_DAYS="14"
# Leave unset in production (defaults to true): managers must verify their email before using the dashboard.
# REQUIRE_EMAIL_VERIFICATION=""

# ── Mobile auth ──────────────────────────────────────────────────────────────
MOBILE_JWT_SECRET=""                  # 32+ random bytes
MOBILE_JWT_KEY_ID="v1"                # bump when rotating MOBILE_JWT_SECRET
MOBILE_ACCESS_TOKEN_TTL_SECONDS="900"
MOBILE_REFRESH_TOKEN_TTL_DAYS="60"

# ── Encryption at rest ───────────────────────────────────────────────────────
INTEGRATION_ENCRYPTION_KEY=""         # exactly 32 bytes, base64 (push tokens, integration credentials)

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Verification, password-reset and invite emails go out through the Resend HTTP API. With EMAIL_PROVIDER="resend"
# and an empty RESEND_API_KEY, or an EMAIL_FROM that is unset (the .local default) or malformed, env() throws on
# first use (every request fails), so set the key and sender before (or with) the provider. EMAIL_FROM's domain
# (clockoff.online) must be verified in Resend (DKIM/SPF records).
# ("console" would only log the subject: no deliverable email. "smtp" is not implemented.)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""                     # Resend API key ("re_…"), sending access only
EMAIL_FROM="ClockOff <noreply@clockoff.online>"

# ── Push (APNs) — optional ───────────────────────────────────────────────────
# All five set → ApnsPushProvider (silent re-sync pushes). Otherwise NoopPushProvider.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_P8_BASE64=""
APNS_BUNDLE_ID="online.clockoff.app"
APNS_ENVIRONMENT="production"

# ── Rate limiting / realtime ─────────────────────────────────────────────────
# "memory" is per serverless instance (best effort). "redis" needs REDIS_URL (adapter not implemented yet).
RATE_LIMIT_BACKEND="memory"
REDIS_URL=""
# Netlify's edge sets x-nf-client-connection-ip to the real client address; use it for rate limiting.
CLIENT_IP_HEADER="x-nf-client-connection-ip"
TRUSTED_PROXY_HOPS="1"

# ── Background job ───────────────────────────────────────────────────────────
# The Netlify Scheduled Function apps/web/netlify/functions/work-mode-tick.mts POSTs /api/jobs/tick on APP_URL
# every minute with "Authorization: Bearer $CRON_SECRET". The in-process node-cron runner is not used.
CRON_SECRET=""                        # 32+ random characters
JOBS_ENABLED="false"

# ── Logging / tooling ────────────────────────────────────────────────────────
LOG_LEVEL="info"
# Must be unset or "false" in production (disables /api/dev/*).
DEV_TOOLS_ENABLED="false"
# Phone test tools ("Create test shift…", POST /api/test-tools/test-shift) for these organisations only
# (comma-separated UUIDs). Production lists only the internal "ClockOff Test" organisation, created by
# apps/web/scripts/setup-test-organisation.ts; every other organisation gets 404 and no button.
TEST_TOOLS_ORGANISATION_IDS="77340865-337d-4ab5-8a18-8f75bf5ab306"

# ── Generating secrets ───────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # SESSION_SECRET, MOBILE_JWT_SECRET, INTEGRATION_ENCRYPTION_KEY
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      # CRON_SECRET
