# ──────────────────────────────────────────────────────────────────────────────
# ClockOff — PRODUCTION environment (Railway project, services `web` and `worker`).
# Every variable the deployed processes read, all at RUNTIME (the Docker builds need none). Both services
# validate the same schema (apps/web/src/lib/env.ts), so define these once as Railway shared variables and
# share them with `web` and `worker`; the per-service notes below say which process actually uses a value.
# Changing a variable redeploys the service. Railway itself provides PORT and RAILWAY_* (replica id, commit).
# Never commit real values. Generate secrets with the commands at the bottom.
#
# DO NOT COPY these Netlify-era variables from the old Netlify site: JOBS_ENABLED (it was "false" there; the worker
# refuses to start while JOBS_ENABLED=false is set), CRON_SECRET (unused) and CLIENT_IP_HEADER
# ="x-nf-client-connection-ip" (no proxy sets that header any more, so clients could pick their own rate-limit
# identity; refused in production). Set the values below instead.
# Full reference: docs/ENVIRONMENT.md · deployment runbook: docs/DEPLOYMENT.md
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Neon, EU region) ───────────────────────────────────────────────
# Pooled connection used by Prisma at runtime (Neon "-pooler" host, PgBouncer transaction mode). Keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-2.aws.neon.tech/clockoff?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) connection, read at RUNTIME by both services: each process's realtime LISTEN session, the
# worker's advisory locks, and web's pre-deploy migrations (/app/migrate.sh). LISTEN and session locks do not work
# through the pooler, so a "-pooler" host or pgbouncer=true here is rejected at startup. Without it the worker
# refuses to start and web's realtime stays in-process.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/clockoff?sslmode=require"

# ── Hostnames ────────────────────────────────────────────────────────────────
# Dashboard + all APIs (manager and mobile). Used for email links, CSRF origin checks and cookies.
APP_URL="https://app.clockoff.online"
NEXT_PUBLIC_APP_URL="https://app.clockoff.online"
# Marketing site (apex). www.<apex> redirects here.
MARKETING_URL="https://clockoff.online"
# "on" makes one deployment serve both sites by hostname (src/server/http/hostRouting.ts).
# Requests to other hosts (e.g. the *.up.railway.app service domain, the health-check probe) are never rerouted.
# Testing on *.up.railway.app before DNS moves: set APP_URL / NEXT_PUBLIC_APP_URL to that domain and HOST_ROUTING="off"
# (CSRF origin checks compare against APP_URL), then restore these values at the cutover.
HOST_ROUTING="on"
# Optional: extra hostnames that should redirect to MARKETING_URL (comma-separated).
MARKETING_ALIAS_HOSTS=""
# Shown in employee invite instructions until the iOS app is on the App Store.
NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/clockoff/id0000000000"

# ── Manager auth ─────────────────────────────────────────────────────────────
# (The Auth.js equivalents AUTH_SECRET/AUTH_URL are SESSION_SECRET/APP_URL here — first-party sessions, D-007.)
SESSION_SECRET=""                     # 32+ random bytes
SESSION_TTL_DAYS="14"
# Leave unset in production (defaults to true): managers must verify their email before using the dashboard.
# REQUIRE_EMAIL_VERIFICATION=""

# ── Mobile auth ──────────────────────────────────────────────────────────────
MOBILE_JWT_SECRET=""                  # 32+ random bytes
MOBILE_JWT_KEY_ID="v1"                # bump when rotating MOBILE_JWT_SECRET
MOBILE_ACCESS_TOKEN_TTL_SECONDS="900"
MOBILE_REFRESH_TOKEN_TTL_DAYS="60"

# ── Encryption at rest ───────────────────────────────────────────────────────
INTEGRATION_ENCRYPTION_KEY=""         # exactly 32 bytes, base64 (push tokens, integration credentials)

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Verification, password-reset and invite emails go out through the Resend HTTP API. With EMAIL_PROVIDER="resend"
# and an empty RESEND_API_KEY, or an EMAIL_FROM that is unset (the .local default) or malformed, env() throws on
# first use (every request fails), so set the key and sender before (or with) the provider. EMAIL_FROM's domain
# (clockoff.online) must be verified in Resend (DKIM/SPF records).
# ("console" would only log the subject: no deliverable email. "smtp" is not implemented.)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""                     # Resend API key ("re_…"), sending access only
EMAIL_FROM="ClockOff <noreply@clockoff.online>"

# ── Push (APNs) — optional ───────────────────────────────────────────────────
# All five set → ApnsPushProvider (silent re-sync pushes). Otherwise NoopPushProvider.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_P8_BASE64=""
APNS_BUNDLE_ID="online.clockoff.app"
APNS_ENVIRONMENT="production"

# ── Rate limiting / client IP ────────────────────────────────────────────────
# "memory" is per web process (one replica). "redis" needs REDIS_URL (adapter not implemented yet).
RATE_LIMIT_BACKEND="memory"
REDIS_URL=""
# Railway's edge sets X-Real-IP to the client's address (documented; client-supplied values are replaced), so it is
# the rate-limit identity. Only "x-real-ip" or "x-forwarded-for" (its leftmost entry, also rewritten by Railway's
# edge) are accepted on Railway in production. Before DNS moves, check on the *.up.railway.app domain that the
# audit log shows your own public IP after a login, and that sending a spoofed X-Real-IP / X-Forwarded-For header
# does not change it. If it shows a Railway CDN address instead (a known X-Real-IP issue on CDN-routed requests),
# switch to "x-forwarded-for". TRUSTED_PROXY_HOPS only applies when no CLIENT_IP_HEADER value is present.
CLIENT_IP_HEADER="x-real-ip"
TRUSTED_PROXY_HOPS="1"

# ── Long-running processes ───────────────────────────────────────────────────
# web: how long one realtime (SSE) stream stays open before a planned reconnect, in ms (10000–840000).
REALTIME_STREAM_MAX_LIFETIME_MS="300000"
# web + worker: graceful-shutdown bound after SIGTERM, in ms (1000–25000). Web exits by then (railway/web.json
# drainingSeconds 30); the worker lets jobs finish for this long and then needs up to ~21 s more for its shutdown
# steps (railway/worker.json drainingSeconds 60). Raising the maximum means raising both draining periods.
SHUTDOWN_GRACE_MS="20000"

# ── Background jobs (worker service only) ────────────────────────────────────
# The worker runs the per-minute Work Mode job, override expiry, schedule upkeep and the 15-minute integrations
# sync, each under a Postgres advisory lock; the web service runs none. "false" is the kill switch: no jobs run,
# while the heartbeat and push-bridge leadership continue (GET /api/health → worker.jobs "disabled"; a healthy
# production reads worker.status "fresh" AND worker.jobs "ok"). Not JOBS_ENABLED: that Netlify-era name is retired.
WORKER_JOBS_ENABLED="true"

# ── Logging / tooling ────────────────────────────────────────────────────────
LOG_LEVEL="info"
# Must be unset or "false" in production (disables /api/dev/*).
DEV_TOOLS_ENABLED="false"
# Phone test tools ("Create test shift…", POST /api/test-tools/test-shift) for these organisations only
# (comma-separated UUIDs). Production lists only the internal "ClockOff Test" organisation, created by
# apps/web/scripts/setup-test-organisation.ts; every other organisation gets 404 and no button.
TEST_TOOLS_ORGANISATION_IDS="77340865-337d-4ab5-8a18-8f75bf5ab306"

# ── Generating secrets ───────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # SESSION_SECRET, MOBILE_JWT_SECRET, INTEGRATION_ENCRYPTION_KEY
