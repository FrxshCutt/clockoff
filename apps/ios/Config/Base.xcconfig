// Base.xcconfig — settings shared by every target and configuration.
#include "Signing.xcconfig"

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 16.4
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0
// Swift 6 toolchain, Swift 5 language mode; strict concurrency checking kept minimal to keep builds green.
SWIFT_STRICT_CONCURRENCY = minimal
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
SWIFT_APPROACHABLE_CONCURRENCY = NO

ENABLE_USER_SCRIPT_SANDBOXING = NO
GCC_TREAT_WARNINGS_AS_ERRORS = NO
CLANG_ENABLE_MODULES = YES
ENABLE_BITCODE = NO

// API_BASE_URL is set per configuration (Debug/Release) and exposed only in the app's Info.plist;
// the extensions never call the API.
// APNs environment reported with the push token (POST /device/push-token).
WORKMODE_PUSH_ENVIRONMENT = sandbox
