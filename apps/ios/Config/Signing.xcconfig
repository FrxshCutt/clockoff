// Signing.xcconfig — bundle identifiers, App Group and team for every target and configuration.
//
// Apple Developer team that owns the online.clockoff.app App IDs, the App Group and the App Store Connect
// record. Automatic signing creates certificates and profiles for it (xcodebuild -allowProvisioningUpdates).
// Simulator builds/tests still run with CODE_SIGNING_ALLOWED=NO (Makefile). A different team (e.g. a personal
// team) can be set in the git-ignored Config/Signing.local.xcconfig, together with bundle id overrides.
// The Family Controls capability must be approved by Apple for the bundle ids below (docs/IOS_SETUP.md).

DEVELOPMENT_TEAM = 78B9UY2V8C
CODE_SIGN_STYLE = Automatic

CLOCKOFF_APP_BUNDLE_ID = online.clockoff.app
CLOCKOFF_MONITOR_BUNDLE_ID = online.clockoff.app.devicemonitor
CLOCKOFF_SHIELD_CONFIG_BUNDLE_ID = online.clockoff.app.shieldconfig
CLOCKOFF_SHIELD_ACTION_BUNDLE_ID = online.clockoff.app.shieldaction
CLOCKOFF_TESTS_BUNDLE_ID = online.clockoff.app.tests

// Must match ClockOffCore `AppGroup.identifier` and every *.entitlements file.
CLOCKOFF_APP_GROUP = group.online.clockoff.app.shared

// Optional, git-ignored: DEVELOPMENT_TEAM (and, for a personal team, bundle id overrides).
#include? "Signing.local.xcconfig"
