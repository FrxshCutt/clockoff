{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "TEST_DATABASE_URL",
    "APP_URL",
    "NEXT_PUBLIC_*",
    "MARKETING_URL",
    "MARKETING_ALIAS_HOSTS",
    "HOST_ROUTING",
    "SESSION_SECRET",
    "SESSION_TTL_DAYS",
    "REQUIRE_EMAIL_VERIFICATION",
    "MOBILE_JWT_*",
    "MOBILE_ACCESS_TOKEN_TTL_SECONDS",
    "MOBILE_REFRESH_TOKEN_TTL_DAYS",
    "INTEGRATION_ENCRYPTION_KEY",
    "EMAIL_PROVIDER",
    "EMAIL_FROM",
    "SMTP_*",
    "RESEND_API_KEY",
    "APNS_*",
    "RATE_LIMIT_BACKEND",
    "REDIS_URL",
    "TRUSTED_PROXY_HOPS",
    "CLIENT_IP_HEADER",
    "JOBS_ENABLED",
    "CRON_SECRET",
    "LOG_LEVEL",
    "DEV_TOOLS_ENABLED",
    "PRISMA_LOG",
    "ALLOW_SEED",
    "SEED_*",
    "INTEGRATION_LOCK_WAIT_SECONDS"
  ],
  "globalDependencies": [".env", "tsconfig.base.json"],
  "tasks": {
    "generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma"]
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "SESSION_SECRET",
        "MOBILE_JWT_SECRET",
        "INTEGRATION_ENCRYPTION_KEY",
        "APP_URL",
        "NEXT_PUBLIC_APP_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^generate", "^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^generate"],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
