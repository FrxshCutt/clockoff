{
  "name": "@clockoff/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, client singleton and seed data.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "migrate:status": "prisma migrate status",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src prisma --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@clockoff/shared": "workspace:*"
  },
  "devDependencies": {
    "@node-rs/argon2": "2.2.1",
    "@types/node": "24.19.1",
    "@clockoff/config": "workspace:*",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "dotenv": "18.0.5"
  }
}
