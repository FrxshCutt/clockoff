}

// ─────────────────────────────────────────────────────────────────────────────
// Overrides, activity, notifications, audit
// ─────────────────────────────────────────────────────────────────────────────

model ManagerOverride {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId        String       @map("organisation_id") @db.Uuid
  /// Null for org-wide EMERGENCY_POLICY_OVERRIDE.
  employeeId            String?      @map("employee_id") @db.Uuid
  type                  OverrideType
  reason                String
  createdById           String?      @map("created_by_id") @db.Uuid
  startsAt              DateTime     @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt             DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt             DateTime?    @map("revoked_at") @db.Timestamptz(6)
  expiredEventEmittedAt DateTime?    @map("expired_event_emitted_at") @db.Timestamptz(6)
