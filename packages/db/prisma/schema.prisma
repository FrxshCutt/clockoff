  @@unique([deviceId, clientEventId])
  @@index([organisationId, occurredAt(sort: Desc)])
  @@index([organisationId, employeeId, occurredAt(sort: Desc)])
  @@index([organisationId, type, occurredAt(sort: Desc)])
  @@map("activity_events")
}

model Notification {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
