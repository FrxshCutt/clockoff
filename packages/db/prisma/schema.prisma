}

/// What a run does (docs/integrations/PLANDAY_IMPLEMENTATION_PLAN.md section 7.2). SYNC is the ordinary full sync.
enum IntegrationSyncRunKind {
  STRUCTURE
  DIRECTORY
  IMPORT_EMPLOYEES
  SYNC
  CLOCK
}

enum PendingExternalEmployeeReason {
  ONBOARDING
  NEW_EMPLOYEE
  AMBIGUOUS_MATCH
