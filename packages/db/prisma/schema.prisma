model ActivityEvent {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String            @map("organisation_id") @db.Uuid
  employeeId     String?           @map("employee_id") @db.Uuid
  deviceId       String?           @map("device_id") @db.Uuid
  actorType      ActorType         @map("actor_type")
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  type           ActivityEventType
  occurredAt     DateTime          @map("occurred_at") @db.Timestamptz(6)
  /// Operational metadata only (§12).
  metadata       Json              @default("{}")
  /// Idempotency key from the device; unique per device (composite below).
  clientEventId  String?           @map("client_event_id")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([deviceId, clientEventId])
  @@index([organisationId, occurredAt(sort: Desc)])
  @@index([organisationId, employeeId, occurredAt(sort: Desc)])
  @@index([organisationId, type, occurredAt(sort: Desc)])
  @@map("activity_events")
}

model Notification {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String                    @map("organisation_id") @db.Uuid
  recipientType  NotificationRecipientType @map("recipient_type")
  recipientId    String                    @map("recipient_id") @db.Uuid
  type           String
  title          String
  body           String
  metadata       Json                      @default("{}")
  channel        NotificationChannel       @default(IN_APP)
  readAt         DateTime?                 @map("read_at") @db.Timestamptz(6)
  sentAt         DateTime?                 @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, recipientType, recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, occurredAt(sort: Desc)])
  @@index([organisationId, entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketing
// ─────────────────────────────────────────────────────────────────────────────

model DemoRequest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String   @db.Citext
  company   String
  teamSize  String?  @map("team_size")
  message   String?
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("demo_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform: background worker runtime
// ─────────────────────────────────────────────────────────────────────────────

/// One row per worker process, upserted every minute; GET /api/health reports the newest live beat.
model WorkerHeartbeat {
  instanceId String    @id @map("instance_id") @db.VarChar(128)
  service    String    @db.VarChar(64)
  version    String?   @db.VarChar(64)
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  lastBeatAt DateTime  @map("last_beat_at") @db.Timestamptz(6)
  /// Set by a graceful shutdown (never bumps lastBeatAt); cleared only by a later process start of the same instance id.
  stoppedAt  DateTime? @map("stopped_at") @db.Timestamptz(6)
  details    Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lastBeatAt(sort: Desc)])
  @@map("worker_heartbeats")
}

/// Last scheduled slot claimed per worker job (at most one run per slot across instances) and its outcome.
model WorkerJobRun {
  job            String    @id @db.VarChar(64)
  lastSlot       BigInt    @map("last_slot")
  lastStartedAt  DateTime  @map("last_started_at") @db.Timestamptz(6)
  lastFinishedAt DateTime? @map("last_finished_at") @db.Timestamptz(6)
  lastOutcome    String?   @map("last_outcome") @db.VarChar(32)
  lastOkAt       DateTime? @map("last_ok_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("worker_job_runs")
}
