{
  "name": "@workmode/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free domain logic shared by the API, web dashboard and tooling: Work Mode state machine, policy resolution, break rules, CSV parsing, time helpers, permissions, privacy statements.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "luxon": "3.7.2",
    "papaparse": "5.7.0",
    "rrule": "2.8.1"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.1",
    "@types/papaparse": "5.5.2",
    "@workmode/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
