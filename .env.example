# ──────────────────────────────────────────────────────────────────────────────
# ClockOff — environment template.
# Copy to `.env` at the repo root (`pnpm setup:env` does this and generates secrets).
# Every variable is documented in docs/ENVIRONMENT.md. Never commit a real `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection used by Prisma (web app, worker, seed). `pnpm db:up` provides this.
DATABASE_URL="postgresql://clockoff:clockoff@localhost:5433/clockoff?schema=public"
# Direct (non-pooled) connection, read at runtime by the web app and the worker for the realtime LISTEN session
# and the worker's advisory locks (neither works through a pooler), and used for migrations. In production it is
# Neon's direct host while DATABASE_URL is the pooled one; locally they are identical. Unset: realtime events
# stay inside one process (the dashboard then only sees the worker's changes through its 30 s refresh).
DIRECT_URL="postgresql://clockoff:clockoff@localhost:5433/clockoff?schema=public"
# Separate database for integration tests (reset between runs — never point at dev data).
TEST_DATABASE_URL="postgresql://clockoff:clockoff@localhost:5433/clockoff_test?schema=public"

# ── App URLs ─────────────────────────────────────────────────────────────────
# Public origin of the web app; used in emails, invite instructions, CSRF origin checks.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Marketing site origin. With HOST_ROUTING="on", MARKETING_URL (+ www) serves the marketing pages and APP_URL the
# dashboard + APIs from one deployment. Keep "off" locally: everything is served from localhost.
MARKETING_URL="http://localhost:3000"
HOST_ROUTING="off"
# Optional extra hostnames that redirect to MARKETING_URL (comma-separated).
MARKETING_ALIAS_HOSTS=""
# Shown in employee invite instructions until the app is on the App Store.
NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/clockoff/id0000000000"

# ── Manager auth (web) ───────────────────────────────────────────────────────
# 32+ random bytes, hex. Signs CSRF tokens and derives session-cookie HMACs.
SESSION_SECRET="replace-with-64-hex-chars"
# Session lifetime in days (sliding expiry).
SESSION_TTL_DAYS="14"
# Require a verified email before a manager can create/use an organisation. Defaults to true when
# NODE_ENV=production and false otherwise. Leave it UNSET in production (or set "true").
# Local development sets it to "false" so the seeded flow works without reading console emails.
REQUIRE_EMAIL_VERIFICATION="false"
# Number of reverse proxies that append to X-Forwarded-For (used to find the client IP for rate limits).
TRUSTED_PROXY_HOPS="1"

# ── Mobile auth (iOS) ────────────────────────────────────────────────────────
# HS256 signing secret for short-lived access tokens. Rotate by adding a new key id.
MOBILE_JWT_SECRET="replace-with-64-hex-chars"
MOBILE_JWT_KEY_ID="v1"
# Access token lifetime (seconds) and refresh token lifetime (days).
MOBILE_ACCESS_TOKEN_TTL_SECONDS="900"
MOBILE_REFRESH_TOKEN_TTL_DAYS="60"

# ── Encryption at rest ───────────────────────────────────────────────────────
# AES-256-GCM key (32 bytes, base64) for integration credentials and push tokens.
INTEGRATION_ENCRYPTION_KEY="replace-with-base64-32-bytes"

# ── Email ────────────────────────────────────────────────────────────────────
# "console" (local default) logs verification / reset / invite links to the server console.
# "resend" sends through the Resend HTTP API (production; needs RESEND_API_KEY and an EMAIL_FROM on a domain
#   verified in Resend). Without a key, or with an EMAIL_FROM on a .local / .test / … domain (like the default
#   below), every send fails: in production env() throws on first use, elsewhere it is a warning.
# "smtp" is reserved for a future SMTP transport (not implemented; configure SMTP_* below).
EMAIL_PROVIDER="console"
EMAIL_FROM="ClockOff <noreply@clockoff.local>"
# Resend API key ("re_…", sending access is enough). Only read when EMAIL_PROVIDER="resend".
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── Push notifications (APNs) ────────────────────────────────────────────────
# When all APNS_* values are set, ApnsPushProvider is used (token-based auth, .p8 key).
# When unset, NoopPushProvider logs intended pushes and the app relies on BGAppRefresh/foreground sync.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_P8_BASE64=""
APNS_BUNDLE_ID="online.clockoff.app"
APNS_ENVIRONMENT="sandbox"

# ── Rate limiting ────────────────────────────────────────────────────────────
# "memory" (single process) or "redis" (set REDIS_URL).
RATE_LIMIT_BACKEND="memory"
REDIS_URL=""

# ── Background jobs (worker process) ─────────────────────────────────────────
# `pnpm worker` runs them (src/worker): the per-minute Work Mode job, override expiry, schedule upkeep and the
# 15-minute integrations sync, each under a Postgres advisory lock. The web app (`pnpm dev`) runs no jobs.
# "false" is the worker's kill switch: no jobs run, while its heartbeat and push-bridge leadership continue.
# (The old JOBS_ENABLED is retired: remove it from older .env files; the worker refuses to start while it is "false".)
WORKER_JOBS_ENABLED="true"

# ── Long-running server ──────────────────────────────────────────────────────
# How long one realtime (SSE) stream stays open before a planned reconnect, in ms (10000–840000).
REALTIME_STREAM_MAX_LIFETIME_MS="300000"
# Upper bound for a graceful shutdown after SIGTERM, in ms (1000–25000). Web exits by then; the worker needs up to
# ~21 s more for its shutdown steps. Both must fit the platform's draining periods (railway/*.json drainingSeconds).
SHUTDOWN_GRACE_MS="20000"

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL="info"

# ── Development only ─────────────────────────────────────────────────────────
# Never set in production. Enables /api/dev/* helpers used by local tooling and Playwright, and the phone
# test tools ("Create test shift…", POST /api/test-tools/test-shift) for every organisation.
DEV_TOOLS_ENABLED="true"

# ── Phone test tools ─────────────────────────────────────────────────────────
# Comma-separated organisation ids (UUIDs) that get the phone test tools — "Create test shift…" on the
# employee and schedule pages, POST /api/test-tools/test-shift — in any environment, production included.
# Not needed locally while DEV_TOOLS_ENABLED=true. Every other organisation gets 404 and no button.
TEST_TOOLS_ORGANISATION_IDS=""
