# ──────────────────────────────────────────────────────────────────────────────
# Work Mode — environment template.
# Copy to `.env` at the repo root (`pnpm setup:env` does this and generates secrets).
# Every variable is documented in docs/ENVIRONMENT.md. Never commit a real `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection used by Prisma (web app, jobs, seed). `pnpm db:up` provides this.
DATABASE_URL="postgresql://workmode:workmode@localhost:5433/workmode?schema=public"
# Separate database for integration tests (reset between runs — never point at dev data).
TEST_DATABASE_URL="postgresql://workmode:workmode@localhost:5433/workmode_test?schema=public"

# ── App URLs ─────────────────────────────────────────────────────────────────
# Public origin of the web app; used in emails, invite instructions, CSRF origin checks.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Shown in employee invite instructions until the app is on the App Store.
NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/work-mode/id0000000000"

# ── Manager auth (web) ───────────────────────────────────────────────────────
# 32+ random bytes, hex. Signs CSRF tokens and derives session-cookie HMACs.
SESSION_SECRET="replace-with-64-hex-chars"
# Session lifetime in days (sliding expiry).
SESSION_TTL_DAYS="14"
# Set to "true" to require a verified email before the dashboard can be used (default true in production).
REQUIRE_EMAIL_VERIFICATION="false"

# ── Mobile auth (iOS) ────────────────────────────────────────────────────────
# HS256 signing secret for short-lived access tokens. Rotate by adding a new key id.
MOBILE_JWT_SECRET="replace-with-64-hex-chars"
MOBILE_JWT_KEY_ID="v1"
# Access token lifetime (seconds) and refresh token lifetime (days).
MOBILE_ACCESS_TOKEN_TTL_SECONDS="900"
MOBILE_REFRESH_TOKEN_TTL_DAYS="60"

# ── Encryption at rest ───────────────────────────────────────────────────────
# AES-256-GCM key (32 bytes, base64) for integration credentials and push tokens.
INTEGRATION_ENCRYPTION_KEY="replace-with-base64-32-bytes"

# ── Email ────────────────────────────────────────────────────────────────────
# "console" logs verification / reset / invite links to the server console (development).
# "smtp" is the production transport (configure SMTP_* below).
EMAIL_PROVIDER="console"
EMAIL_FROM="Work Mode <no-reply@workmode.local>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── Push notifications (APNs) ────────────────────────────────────────────────
# When all APNS_* values are set, ApnsPushProvider is used (token-based auth, .p8 key).
# When unset, NoopPushProvider logs intended pushes and the app relies on BGAppRefresh/foreground sync.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_P8_BASE64=""
APNS_BUNDLE_ID="com.workmode.app"
APNS_ENVIRONMENT="sandbox"

# ── Rate limiting ────────────────────────────────────────────────────────────
# "memory" (single process) or "redis" (set REDIS_URL).
RATE_LIMIT_BACKEND="memory"
REDIS_URL=""

# ── Background jobs ──────────────────────────────────────────────────────────
# The minute scheduler (`pnpm jobs`) and the HTTP tick endpoint (/api/jobs/tick) share this secret.
JOBS_ENABLED="true"
CRON_SECRET="replace-with-random-string"

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL="info"

# ── Development only ─────────────────────────────────────────────────────────
# Never set in production. Enables /api/dev/* helpers used by local tooling and Playwright.
DEV_TOOLS_ENABLED="true"
